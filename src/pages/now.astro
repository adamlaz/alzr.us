---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const updated = new Date('2026-08-15');
const formatted = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const posts = (await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = posts[0];
---

<BaseLayout title="Now -- alzr.us" description="What Adam Lazarus is working on this month.">
  <h1 class="route-title" transition:name="route-now">Now</h1>
  <p class="kicker">
    A <a href="https://nownownow.com/about" rel="external">/now page</a>: what's actually
    on my desk this month. The longer arc is on <a href="/projects">Work</a>.
  </p>

  <ul class="now-list">
    <li>
      <strong>Day job-</strong> the senior mobile hire from the
      <a href="/writing/the-interview-after-the-research">hiring posts</a> landed and
      started; the research workflow behind it got packaged as a kit a teammate now
      runs (<a href="/writing/giving-the-brief-away">that story</a>), and it's pointed
      at an engineering-leadership search next.
    </li>
    <li>
      <strong>Advisory-</strong> the diagnostic I owed a write-up finally has one-
      <a href="/writing/nine-hypotheses-three-days-onsite">Nine hypotheses, three days
      onsite</a>. The survey package is in the client's hands for the 90-day re-run.
    </li>
    <li>
      <strong>Writing-</strong> five drafts cleared the editorial gate in one August push;
      twelve posts on the site now.{
        latest && (
          <Fragment>
            {' '}
            Latest- <a href={`/writing/${latest.id}`}>{latest.data.title}</a>.
          </Fragment>
        )
      }
    </li>
    <li>
      <strong>Personal tooling-</strong> the morning vault automation keeps growing-
      newest pieces are a drafted daily standup and reply drafts for texts I haven't
      answered (drafts only; nothing sends itself). The 3D printer queue is its own
      backlog now- see <a href="/writing/cad-by-conversation">CAD by conversation</a>.
    </li>
  </ul>

  <p class="updated">
    Last updated: <time datetime={updated.toISOString()}>{formatted}</time>
  </p>
</BaseLayout>

<style>
  /* .kicker is a shared primitive in global.css. */
  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .now-list li {
    padding: var(--list-gap) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text);
  }

  .now-list li:last-child {
    border-bottom: 0;
  }

  .now-list strong {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 18, 'SOFT' 50, 'WONK' 0;
    font-weight: 500;
    color: var(--text);
    margin-right: var(--space-2xs);
  }

  .updated {
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--text-muted);
  }
</style>
