---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const updated = new Date('2026-06-15');
const formatted = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = posts[0];
---

<BaseLayout title="Now -- alzr.us" description="What Adam Lazarus is working on this month.">
  <h1 class="route-title" transition:name="route-now">Now</h1>
  <p class="kicker">
    A <a href="https://nownownow.com/about" rel="external">/now page</a>: what's actually
    on my desk this month. The longer arc is on <a href="/projects">Work</a>.
  </p>

  <ul class="now-list">
    <li>
      <strong>Day job-</strong> mid-way through a senior mobile hire, running the
      parallel-agent research and the per-candidate interview pages from the
      <a href="/writing/the-interview-after-the-research">hiring posts</a> against a live
      candidate pool.
    </li>
    <li>
      <strong>Advisory-</strong> the engagement I wrapped this spring is turning into the
      next post I owe: a sanitized walkthrough of the audit kit. Not written yet.
    </li>
    <li>
      <strong>Writing-</strong> just pushed a run of new posts; settling back to roughly one a month.{
        latest && (
          <Fragment>
            {' '}
            Latest- <a href={`/writing/${latest.id}`}>{latest.data.title}</a>.
          </Fragment>
        )
      }
    </li>
    <li>
      <strong>Personal tooling-</strong> extending the automation that rebuilds my Obsidian
      vault every morning. Right now: a deploy logger for this site and a
      research-narrative rollup.
    </li>
    <li>
      <strong>Off the screen-</strong> diving a couple times a month, and the 3D printer is
      mostly making car parts at the moment.
    </li>
  </ul>

  <p class="updated">
    Last updated: <time datetime={updated.toISOString()}>{formatted}</time>
  </p>
</BaseLayout>

<style>
  /* .kicker is a shared primitive in global.css. */
  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .now-list li {
    padding: var(--list-gap) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text);
  }

  .now-list li:last-child {
    border-bottom: 0;
  }

  .now-list strong {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 18, 'SOFT' 50, 'WONK' 0;
    font-weight: 500;
    color: var(--text);
    margin-right: var(--space-2xs);
  }

  .updated {
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--text-muted);
  }
</style>
