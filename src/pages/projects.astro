---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Engineering leadership, day job',
    period: 'Oct 2025 -- present',
    summary:
      "Director of Engineering at a consumer-tech company that helps families preserve their memories. The bet is AI-augmented engineering on a small team that ships product, not tickets. In flight- mobile redesign, share-gate conversion work, design system buildout, social comments shipping. Less middle-management, more taste.",
  },
  {
    title: 'Independent advisory',
    period: '2017 -- present',
    summary:
      "Small engineering consultancy. DORA / Westrum / DevEx audits for engineering orgs in the 50-200 range. AI-augmented engineering rollouts on small teams. Occasional 1:1 work with newly-promoted directors. Most recent engagement- a multi-month diagnostic for a co-CEO ramp, wrapped May 25, 2026; the sanitized methodology post is queued. By referral.",
  },
  {
    title: 'Writing',
    period: '2026 -- present',
    summary:
      "Long-form posts on engineering practice. Three shipped during a 3-day blitz at the end of May 2026- parallel agents for hiring research, a writing-voice guide for AI assistants, a founder-to-operator-mode essay. Target cadence is one post a month. Drafts queued- a DORA / Westrum / DevEx engagement walkthrough, the vault as a personal automation platform, AI-fake-resume patterns.",
  },
  {
    title: 'Backyard build',
    period: 'May 2026 -- ongoing',
    summary:
      "Designing and contracting an integrated backyard build at the St. Pete house- a custom-framed cypress-decked sauna with a full glass front, an outdoor shower, a cypress screen fence, refreshed landscape, and travertine restoration. Five trades, owner-coordinated. Bids out, permits pending. Florida wind code makes hurricane anchorage and the continuous load path the real engineering problem.",
  },
];

const priorWork = [
  {
    period: '2018 -- 2024',
    title: 'Consumer health platform',
    summary:
      'Director of Product & Software Dev at a large consumer-health ecommerce platform. Owned the P&L for mobile + web, scaled the engineering org through a CPaaS migration, ran the design system and DevEx workstream.',
  },
  {
    period: '2010 -- 2018',
    title: 'Multi-venture founder era',
    summary:
      "Co-founder and CTO across four small companies -- one stuck, three didn't. Built early-stage iOS, fintech-adjacent web, and the systems plumbing for a couple of vertical SaaS swings.",
  },
  {
    period: '2010 -- 2016',
    title: 'iOS apps shipped',
    summary:
      "Native iOS for a backend-as-a-service (open source, ~200 repos in the org), a TensorFlow self-driving game demo that had a moment in 2017, a couple of consumer apps that didn't.",
  },
];
---

<BaseLayout title="Projects -- alzr.us" description="What Adam Lazarus is currently building, and the prior work that got him here.">
  <h1>Projects</h1>
  <p class="kicker">A short list. The ones with real time invested in them.</p>

  <ul class="project-list">
    {
      projects.map((p) => (
        <li>
          <header>
            <h2>{p.title}</h2>
            <span class="period">{p.period}</span>
          </header>
          <p>{p.summary}</p>
        </li>
      ))
    }
  </ul>

  <section class="prior">
    <h2 class="prior-title">Prior work</h2>
    <p class="prior-kicker">
      Fifteen years before the current chapter. Anonymized on purpose -- the
      methods stay, the affiliations don't.
    </p>
    <ol class="timeline">
      {
        priorWork.map((p) => (
          <li>
            <span class="timeline-period">{p.period}</span>
            <div class="timeline-body">
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <p class="more">
    Public code lives at <a href="https://github.com/adamlaz" rel="external me" data-no-prerender>github.com/adamlaz</a>.
  </p>
</BaseLayout>

<style>
  /* .kicker is a shared primitive in global.css. */
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list li {
    padding: var(--list-gap) 0;
    border-bottom: 1px solid var(--rule);
  }

  .project-list li:last-child {
    border-bottom: 0;
  }

  .project-list header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xs);
    flex-wrap: wrap;
  }

  .project-list h2 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 1.4rem;
    color: var(--text);
    margin: 0;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-list p {
    color: var(--text-soft);
    margin: 0;
  }

  /* Prior work -- typographic micro-timeline. A major section break
     (rule + generous space), then a denser sub-list for deliberate
     rhythm contrast against the top-level project list above. */
  .prior {
    margin-top: var(--section-gap);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }

  .prior-title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 1.4rem;
    color: var(--text);
    margin: 0 0 var(--space-2xs);
  }

  .prior-kicker {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 16, 'SOFT' 60, 'WONK' 0;
    font-style: italic;
    color: var(--text-soft);
    margin: 0 0 var(--space-lg);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--rule);
  }

  .timeline li:last-child {
    border-bottom: 0;
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-top: 0.4rem;
  }

  .timeline h3 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 28, 'SOFT' 50, 'WONK' 0;
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 var(--space-3xs);
  }

  .timeline p {
    color: var(--text-soft);
    margin: 0;
    line-height: 1.55;
  }

  @media (max-width: 540px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
    .timeline-period {
      padding-top: 0;
    }
  }

  .more {
    margin-top: var(--space-xl);
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>
