---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Independent advisory',
    period: '2024 -- present',
    summary:
      "I run a small engineering consultancy. DORA / Westrum / DevEx audits, AI-augmentation playbooks, leadership coaching. Engagements are by referral.",
  },
  {
    title: 'Vault automation',
    period: '2024 -- present',
    summary:
      "A personal Obsidian vault that runs like a data pipeline. iMessage extraction, Amazon-order ingestion, AI-classified email triage, daily reflections. Everything logged to a single Activity Log spine. Scheduled via launchd, 6 AM ET.",
  },
  {
    title: 'Day job',
    period: '2024 -- present',
    summary:
      "Director of Engineering at a consumer-tech company that helps families preserve their memories. I'm building the playbook for AI-augmented engineering on a small team. Less ticket-pushing, more taste.",
  },
];
---

<BaseLayout title="Projects -- alzr.us" description="What Adam Lazarus is currently building.">
  <h1>Projects</h1>
  <p class="kicker">A short list. The ones with real time invested.</p>

  <ul class="project-list">
    {
      projects.map((p) => (
        <li>
          <header>
            <h2>{p.title}</h2>
            <span class="period">{p.period}</span>
          </header>
          <p>{p.summary}</p>
        </li>
      ))
    }
  </ul>

  <p class="more">
    Public code lives at <a href="https://github.com/adamlaz" rel="external me" data-no-prerender>github.com/adamlaz</a>.
  </p>
</BaseLayout>

<style>
  .kicker {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 18, 'SOFT' 50, 'WONK' 0;
    font-size: 1.1rem;
    color: var(--text-soft);
    margin-bottom: 3rem;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .project-list li:last-child {
    border-bottom: 0;
  }

  .project-list header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .project-list h2 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 1.4rem;
    color: var(--text);
    margin: 0;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-list p {
    color: var(--text-soft);
    margin: 0;
  }

  .more {
    margin-top: 3rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>
