---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Engineering leadership, day job',
    period: 'Oct 2025 -- present',
    summary:
      "Director of Engineering at a consumer-tech company. The bet is AI-augmented engineering on a small team that ships product, not tickets. Less middle-management, more taste.",
  },
  {
    title: 'Independent advisory',
    period: '2017 -- present',
    summary:
      "Small engineering consultancy. DORA / Westrum / DevEx audits for engineering orgs in the 50-200 range. AI-augmented engineering rollouts on small teams. Occasional 1:1 work with newly-promoted directors. Most recent engagement- a multi-month engineering diagnostic for a leadership transition, recently wrapped. A sanitized methodology writeup is in the queue. By referral.",
  },
  {
    title: 'Posts',
    period: '2026 -- present',
    summary:
      "Long-form posts on engineering practice. Three shipped during a 3-day blitz at the end of May 2026- parallel agents for hiring research, a writing-voice guide for AI assistants, a founder-to-operator-mode essay. Target cadence is one post a month. Drafts in the pipeline- a DORA / Westrum / DevEx engagement walkthrough, the vault as a personal automation platform, AI-fake-resume patterns.",
  },
  {
    title: 'Backyard build',
    period: 'May 2026 -- ongoing',
    summary:
      "Designing and contracting an integrated backyard build- a custom-framed cypress-decked sauna, an outdoor shower, refreshed landscape. Owner-coordinated across multiple trades. Florida wind code makes hurricane anchorage and the continuous load path the real engineering problem; the rest is project management.",
  },
];

const priorWork = [
  {
    period: '2023 -- 2025',
    title: 'Consumer health platform',
    summary:
      "Senior PM, then Director of Product & Software Dev at a large consumer-health ecommerce platform. Owned the P&L for mobile + web, ran a CPaaS migration with no downtime on a 400K subscription base, built the team I still call the most rewarding team-building work of my career.",
  },
  {
    period: '2016 -- 2022',
    title: 'Multi-venture founder',
    summary:
      "Co-founded four small companies in this window with a long-running engineering partner. The one that stuck was a vertical-SaaS swing in a regulated B2B space; scaled into the hundreds of thousands of monthly users with engineering running offshore. The other three didn't. St. Petersburg, FL chapter starts here.",
  },
  {
    period: '2011 -- 2016',
    title: 'LA consulting era',
    summary:
      "Early hire at a compliance startup reporting to the CEO; the business unit got acquired and that triggered the next chapter. Concurrent- co-founded a boutique consulting firm in LA, contractor-heavy across several client verticals. Two muscle groups built at once. Started in Waltham, MA at IBM; ended in Hollywood, CA.",
  },
  {
    period: '2007 -- 2011',
    title: 'Enterprise / student',
    summary:
      "University of Tampa, BS in MIS, class of 2011. Concurrent internships through the late aughts- engineering intern at a major social platform through its public developer-platform launch (wrote the first public docs), plus student-partner and contracting work in the broader Big Tech orbit. Won a developer contest senior year that turned into the first post-undergrad job. MIT SDM Executive MBA initiative, one semester.",
  },
  {
    period: '2002 -- 2007',
    title: 'Founder mode',
    summary:
      "Started a web-design business at 13, building HTML sites for small businesses around the New England town where I grew up. Incorporated at 15, expanded into broader tech consulting at 17. Concurrent- lifeguard, then waterfront manager, then sailing instructor at the boat club. PADI Dive Master cert in the British Virgin Islands at 15. USCG Master 100-Tons captain's license. The pattern everything later inherits.",
  },
];
---

<BaseLayout title="Work -- alzr.us" description="What Adam Lazarus is currently building, and the prior work that got him here.">
  <h1>Work</h1>
  <p class="kicker">A short list. The ones with real time invested in them.</p>

  <ul class="project-list">
    {
      projects.map((p) => (
        <li>
          <header>
            <h2>{p.title}</h2>
            <span class="period">{p.period}</span>
          </header>
          <p>{p.summary}</p>
        </li>
      ))
    }
  </ul>

  <section class="prior">
    <h2 class="prior-title">Prior work</h2>
    <p class="prior-kicker">
      Fifteen years before the current chapter. Anonymized on purpose -- the
      methods stay, the affiliations don't.
    </p>
    <ol class="timeline">
      {
        priorWork.map((p) => (
          <li>
            <span class="timeline-period">{p.period}</span>
            <div class="timeline-body">
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <p class="more">
    Public code lives at <a href="https://github.com/adamlaz" rel="external me" data-no-prerender>github.com/adamlaz</a>.
  </p>

  <p class="coda">
    <em>Off the keyboard- on, around, or under the water. Scuba a few times a month, recording while friends spearfish. PADI Dive Master. The shop runs a Bambu printer.</em>
  </p>
</BaseLayout>

<style>
  /* .kicker is a shared primitive in global.css. */
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list li {
    padding: var(--list-gap) 0;
    border-bottom: 1px solid var(--rule);
  }

  .project-list li:last-child {
    border-bottom: 0;
  }

  .project-list header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xs);
    flex-wrap: wrap;
  }

  .project-list h2 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 1.4rem;
    color: var(--text);
    margin: 0;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-list p {
    color: var(--text-soft);
    margin: 0;
  }

  /* Prior work -- typographic micro-timeline. A major section break
     (rule + generous space), then a denser sub-list for deliberate
     rhythm contrast against the top-level project list above. */
  .prior {
    margin-top: var(--section-gap);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }

  .prior-title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 1.4rem;
    color: var(--text);
    margin: 0 0 var(--space-2xs);
  }

  .prior-kicker {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 16, 'SOFT' 60, 'WONK' 0;
    font-style: italic;
    color: var(--text-soft);
    margin: 0 0 var(--space-lg);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--rule);
  }

  .timeline li:last-child {
    border-bottom: 0;
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-top: 0.4rem;
  }

  .timeline h3 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 28, 'SOFT' 50, 'WONK' 0;
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 var(--space-3xs);
  }

  .timeline p {
    color: var(--text-soft);
    margin: 0;
    line-height: 1.55;
  }

  @media (max-width: 540px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
    .timeline-period {
      padding-top: 0;
    }
  }

  .more {
    margin-top: var(--space-xl);
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .coda {
    margin-top: var(--space-sm);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 16, 'SOFT' 60, 'WONK' 0;
    font-size: 0.95rem;
    color: var(--text-soft);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .coda em {
    font-style: italic;
  }
</style>
