---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const current = [
  {
    period: '2025 -- present',
    title: 'Director of Engineering',
    summary:
      "Director of Engineering at a consumer-tech company, running an AI-augmented team that ships product, not tickets. Recent surface: a mobile redesign, a share-to-convert flow, a design-system rebuild.",
  },
  {
    period: '2017 -- present',
    title: 'Engineering advisory practice',
    summary:
      'Independent, by referral. DORA / Westrum / DevEx audits for orgs in the 50-200 range, AI-augmented engineering rollouts on small teams, and 1:1 work with newly-promoted directors.',
  },
];

const arc = [
  {
    period: '~2018 -- 2024',
    title: 'Consumer-platform leadership',
    summary:
      "Led product and software at a large consumer platform: a zero-downtime CPaaS migration on a big subscriber base, P&L across mobile and web, and the best team I've built.",
  },
  {
    period: '~2010 -- 2018',
    title: 'The founder decade',
    summary:
      "Co-founded four small companies with a long-running engineering partner. One found traction; three didn't. Alongside it: an early operating role at a venture-backed startup and a boutique consulting practice across several verticals. Started on the East Coast, ended on the West, landed in St. Petersburg.",
  },
  {
    period: 'late 2000s',
    title: 'Enterprise and school',
    summary:
      'An information-systems degree in Florida and internships across enterprise software and the broader Big Tech orbit: developer docs and tooling for a platform launch, contract and student-partner work, a contest win that turned into the first full-time job. One semester into a systems-design grad program.',
  },
  {
    period: 'the 2000s',
    title: 'Founder mode, the original',
    summary:
      'Started a web-design business as a teenager and incorporated it a couple years later, building sites for small businesses around the New England town where I grew up. The pattern everything later inherits.',
  },
];

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = posts[0];
---

<BaseLayout
  title="Work -- alzr.us"
  description="What Adam Lazarus is building now, and the two-decade founder-to-operator arc that got here."
>
  <h1 class="route-title" transition:name="route-projects">Work</h1>
  <p class="kicker">
    Two decades building engineering teams and shipping product, founder-side and
    operator-side. What I'm doing now, and the arc that got here.
  </p>

  <ul class="work-list">
    {
      current.map((p) => (
        <li>
          <span class="period eyebrow">{p.period}</span>
          <h2>{p.title}</h2>
          <p>{p.summary}</p>
        </li>
      ))
    }
  </ul>

  <p class="more">
    Also: long-form <a href="/writing">posts</a> on engineering practice, about one a
    month.{
      latest && (
        <Fragment>
          {' '}
          Latest- <a href={`/writing/${latest.id}`}>{latest.data.title}</a>.
        </Fragment>
      )
    }
  </p>

  <section class="arc">
    <h2 class="arc-title">The arc</h2>
    <p class="arc-kicker">Anonymized on purpose -- the methods stay, the affiliations don't.</p>
    <ol class="timeline">
      {
        arc.map((e) => (
          <li>
            <span class="timeline-period eyebrow">{e.period}</span>
            <h3>{e.title}</h3>
            <p>{e.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <p class="more coda">
    Off the keyboard- a USCG Master captain's license, a standing dive habit, and a 3D
    printer that mostly makes car parts.
  </p>
  <p class="more">
    The code for this site is on <a
      href="https://github.com/adamlaz/alzr.us"
      rel="external"
      data-no-prerender>GitHub</a
    >.
  </p>
</BaseLayout>

<style>
  /* .kicker is a shared primitive in global.css. */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-list li {
    padding: var(--list-gap) 0;
    border-bottom: 1px solid var(--rule);
  }

  .work-list li:last-child {
    border-bottom: 0;
  }

  /* Metadata on top, matching PostCard so /writing and /work align. */
  .work-list .period {
    display: block;
    margin-bottom: var(--space-3xs);
  }

  .work-list h2 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 1.5rem;
    color: var(--text);
    margin: 0 0 var(--space-2xs);
  }

  .work-list p {
    color: var(--text-soft);
    margin: 0;
  }

  /* The arc -- a left-rail timeline. A major section break (rule + space),
     then a vertical hairline with a node per era so it reads as an arc, not
     a table. All inside the paper-and-ink tokens; no new color. */
  .arc {
    margin-top: var(--section-gap);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }

  .arc-title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 1.4rem;
    color: var(--text);
    margin: 0 0 var(--space-2xs);
  }

  .arc-kicker {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 16, 'SOFT' 60, 'WONK' 0;
    font-style: italic;
    color: var(--text-soft);
    margin: 0 0 var(--space-lg);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-lg);
    position: relative;
  }

  /* the rail */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--rule);
  }

  .timeline li {
    position: relative;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--rule);
  }

  .timeline li:last-child {
    border-bottom: 0;
  }

  /* the node -- centered on the 1px rail, with a paper ring masking the line */
  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-lg) - 3px);
    top: 1.2rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg);
  }

  .timeline-period {
    display: block;
    margin-bottom: var(--space-3xs);
  }

  .timeline h3 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 28, 'SOFT' 50, 'WONK' 0;
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 var(--space-3xs);
  }

  .timeline p {
    color: var(--text-soft);
    margin: 0;
    line-height: 1.55;
  }

  .more {
    margin-top: var(--space-xl);
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .more.coda {
    margin-top: var(--section-gap);
  }

  .more + .more {
    margin-top: var(--space-sm);
  }
</style>
