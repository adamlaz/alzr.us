---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
---

<BaseLayout
  title="Adam Lazarus"
  description="Adam Lazarus -- engineering leader at a consumer-tech company, independent advisor at the business / engineering / AI seam. Long-form posts on AI-augmented engineering and what works on small teams. St. Petersburg, FL."
>
  <section class="hero">
    <span class="welcome" data-visit-state="loading"></span>
    <Wordmark hero text="alzr.us" />
    <p class="lede">
      Adam Lazarus. St. Petersburg, FL. Director of Engineering at a small
      consumer-tech company. Independent advisory practice bridging business,
      engineering, and AI. Fifteen years of shipping consumer products,
      founder-side and operator-side. Scuba a few times a month, skiing when
      the snow's right.
    </p>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const KEY = 'alzr_last_visit';
    const el = document.querySelector('.welcome');
    if (!el) return;
    const now = new Date();
    const prev = localStorage.getItem(KEY);
    let state = 'first';
    let days = 0;
    if (prev) {
      const prevDate = new Date(prev);
      days = Math.max(0, Math.floor((now.getTime() - prevDate.getTime()) / 86400000));
      if (days <= 7) state = 'recent';
      else if (days <= 60) state = 'medium';
      else state = 'distant';
    }
    el.setAttribute('data-days', String(days));
    el.setAttribute('data-visit-state', state);
    localStorage.setItem(KEY, now.toISOString());
  })();
</script>

<style>
  .hero {
    padding-top: var(--space-sm);
  }

  .welcome {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: lowercase;
    margin-bottom: var(--space-sm);
    min-height: 1.2em;
  }

  .welcome[data-visit-state='loading']::before {
    content: '';
  }
  .welcome[data-visit-state='first']::before {
    content: 'first time? hello.';
  }
  .welcome[data-visit-state='recent']::before {
    content: attr(data-days) ' days. back so soon?';
  }
  .welcome[data-visit-state='medium']::before {
    content: 'back again. it\'s been ' attr(data-days) ' days.';
  }
  .welcome[data-visit-state='distant']::before {
    content: 'welcome back. it\'s been months.';
  }

  .lede {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'SOFT' 50, 'WONK' 0;
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.375rem);
    line-height: 1.45;
    color: var(--text-soft);
    margin-top: var(--space-lg);
    text-wrap: pretty;
    max-width: var(--measure);
  }

</style>
