---
import { getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import DepthControl from '../../components/post/DepthControl.astro';
import DepthPrepaint from '../../components/post/DepthPrepaint.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEPTH_DEFAULT, DEPTH_LABELS, DEPTH_LEVELS, depthBodyAt, usesDepth } from '../../lib/depth';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatted = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  // Frontmatter dates parse as midnight UTC; format there so the byline
  // doesn't slip a day in timezones west of it.
  timeZone: 'UTC',
});

const body = post.body ?? '';
const minutesFor = (text: string) => Math.max(1, Math.round(readingTime(text).minutes));

// Depth posts: reading time per level, computed from the body as each level
// would show it. Level 3 is server-rendered; the slider swaps in the rest.
const isDepth = post.data.depth;
if (!isDepth && usesDepth(body)) {
  throw new Error(`writing/${post.id}: uses <Depth> but its frontmatter is missing \`depth: true\`.`);
}
const depthMinutes = isDepth ? DEPTH_LEVELS.map((level) => minutesFor(depthBodyAt(body, level))) : [];
const minutes = isDepth ? depthMinutes[DEPTH_DEFAULT - 1] : minutesFor(body);
const readMin = `${minutes} min read`;

const ogImage = `/og/${post.id}.png${post.data.ogImageVersion ? `?v=${post.data.ogImageVersion}` : ''}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogImageAlt={`${post.data.title} -- alzr.us`}
  ogType="article"
  publishedTime={post.data.date}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="post">
    <header>
      <p class:list={['meta eyebrow', { 'meta--depth': isDepth }]}>
        <time datetime={post.data.date.toISOString()}>{formatted}</time>
        {/* Depth posts show level and minutes under the slider; repeating them here read as a stutter. */}
        {
          !isDepth && (
            <>
              <span class="dot" aria-hidden="true">·</span>
              <span class="reading-time">{readMin}</span>
            </>
          )
        }
      </p>
      <h1 data-kinetic transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      {isDepth && <DepthControl variant="header" minutes={depthMinutes} />}
    </header>
    <div
      class="body"
      data-depth-root={isDepth ? '' : undefined}
      data-depth={isDepth ? DEPTH_DEFAULT : undefined}
      data-depth-minutes={isDepth ? depthMinutes.join(' ') : undefined}
      data-depth-labels={isDepth ? DEPTH_LEVELS.map((level) => DEPTH_LABELS[level]).join('|') : undefined}
    >
      {isDepth && <DepthPrepaint />}
      <Content />
    </div>
    <footer data-depth-end={isDepth ? '' : undefined}>
      <a href="/writing">← All posts</a>
    </footer>
    {isDepth && <DepthControl variant="sticky" minutes={depthMinutes} />}
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-sm);
  }

  /* Reading-progress hairline -- scroll-driven, pure CSS, no JS. A cobalt
     hairline pinned to the top edge, scaled by document scroll via a scroll()
     timeline. On-brand: the site already uses hairline rules as a motif. */
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    z-index: var(--z-progress);
  }

  @supports (animation-timeline: scroll()) {
    .reading-progress {
      animation: reading-progress-grow linear both;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes reading-progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* No scroll-timeline support (Firefox) leaves it at scaleX(0) -- invisible,
     no broken layout. Reduced motion drops it outright: the read is complete
     without it, and this sidesteps the global animation-duration override. */
  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }

  header {
    margin-bottom: var(--space-lg);
  }

  .meta {
    /* visual recipe comes from the shared .eyebrow utility */
    margin: 0 0 var(--space-3xs);
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .meta .dot {
    color: var(--rule);
  }

  /* Depth posts: the readout ("Balanced · 6 min read") changes length with the
     level. Below md it takes its own line, so the header never re-wraps (and
     shifts the page) as the reader drags. */
  .meta--depth {
    flex-wrap: wrap;
    row-gap: var(--space-3xs);
  }

  .meta--depth .reading-time {
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .meta--depth .dot {
      display: none;
    }

    .meta--depth .reading-time {
      flex-basis: 100%;
    }
  }

  h1 {
    margin: var(--space-3xs) 0 var(--space-xs);
  }

  .description {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'SOFT' 50, 'WONK' 0;
    font-size: 1.2rem;
    color: var(--text-soft);
    margin: 0;
  }

  /* Anchor links on headings: # reveals on hover */
  .body :global(h2),
  .body :global(h3) {
    margin-top: 2.5rem;
    position: relative;
  }

  .body :global(.heading-anchor) {
    position: absolute;
    left: -1.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
    text-decoration: none;
    opacity: 0;
    transition: opacity 140ms ease;
    font-weight: normal;
    font-size: 0.7em;
    padding: 0 0.2rem;
  }

  .body :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  @media (hover: hover) {
    .body :global(h2:hover .heading-anchor),
    .body :global(h3:hover .heading-anchor) {
      opacity: 1;
    }
  }

  /* Below lg (48rem) the gutter is too tight to hang the # outside the column
     without it riding the viewport edge -- worse now that the gutter is fluid.
     Pin it inside, at the heading's trailing edge: no overflow at any width,
     still revealed on focus, still tappable. */
  @media (max-width: 48rem) {
    .body :global(.heading-anchor) {
      left: auto;
      right: 0;
    }
  }

  .body :global(pre) {
    background: var(--accent-subtle);
    padding: 1rem 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.5;
    border: 1px solid var(--rule);
  }

  /* Shiki dual-theme: tokens carry --shiki-light / --shiki-dark and no hardcoded
     color (defaultColor: false), so we apply light by default and swap to dark
     under the theme toggle. The block keeps the on-brand --accent-subtle bg. */
  .body :global(.astro-code),
  .body :global(.astro-code span) {
    color: var(--shiki-light);
  }

  :global(html[data-theme='dark']) .body :global(.astro-code),
  :global(html[data-theme='dark']) .body :global(.astro-code span) {
    color: var(--shiki-dark);
  }

  /* Markdown lists: the reset strips markers, so prose lists ran together as
     plain lines. Restore them for prose only: component lists carry a class
     or sit inside the footnotes, and keep their own styling. */
  .body :global(:is(ul, ol):not([class]):not(.footnotes *)) {
    margin: 0 0 var(--space-md);
    padding-left: 1.4em;
  }

  .body :global(ul:not([class]):not(.footnotes *)) {
    list-style: disc;
  }

  .body :global(ol:not([class]):not(.footnotes *)) {
    list-style: decimal;
  }

  .body :global(:is(ul, ol):not([class]):not(.footnotes *) > li) {
    margin: 0.3em 0;
    padding-left: 0.15em;
  }

  .body :global(:is(ul, ol):not([class]):not(.footnotes *) > li::marker) {
    color: var(--text-muted);
  }

  /* Markdown tables: hairline rules, mono eyebrow headers, scroll on mobile. */
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-lg) 0;
    font-size: 0.92rem;
  }

  .body :global(thead th) {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: left;
    font-weight: 500;
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid var(--rule);
  }

  .body :global(tbody td) {
    padding: 0.6rem 0.8rem;
    vertical-align: top;
    color: var(--text-soft);
    line-height: 1.55;
    border-bottom: 1px solid var(--rule);
  }

  .body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  @media (max-width: 40rem) {
    .body :global(table) {
      display: block;
      overflow-x: auto;
    }
  }

  .body :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: var(--space-sm);
    color: var(--text-soft);
    font-style: italic;
    margin: var(--space-md) 0;
  }

  .body :global(p) {
    line-height: 1.7;
  }

  .body :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid
      color-mix(in oklch, var(--accent) 35%, transparent);
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  @media (hover: hover) {
    .body :global(a:hover) {
      color: var(--accent-hover);
      border-bottom-color: currentColor;
    }
  }

  footer {
    margin-top: var(--section-gap);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  footer a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    position: relative;
    display: inline-block;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  /* 44px tap strip; underline stays on the baseline (no vertical padding). */
  footer a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: var(--tap);
    transform: translateY(-50%);
  }

  @media (hover: hover) {
    footer a:hover {
      color: var(--accent-hover);
      border-bottom-color: var(--accent-hover);
    }
  }

  footer a:active {
    color: var(--accent-hover);
    border-bottom-color: var(--accent-hover);
  }
</style>
