---
import { getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatted = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const rt = readingTime(post.body ?? '');
const minutes = Math.max(1, Math.round(rt.minutes));
const readMin = `${minutes} min read`;

const ogImage = `/og/${post.id}.png`;
---

<BaseLayout
  title={`${post.data.title} -- alzr.us`}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={post.data.date}
>
  <article class="post">
    <header>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatted}</time>
        <span class="dot" aria-hidden="true">·</span>
        <span class="reading-time">{readMin}</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
    </header>
    <div class="body">
      <Content />
    </div>
    <footer>
      <a href="/writing">← All writing</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-sm);
  }

  header {
    margin-bottom: var(--space-lg);
  }

  .meta {
    margin: 0 0 var(--space-3xs);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .meta .dot {
    color: var(--rule);
  }

  h1 {
    margin: var(--space-3xs) 0 var(--space-xs);
  }

  .description {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 24, 'SOFT' 50, 'WONK' 0;
    font-size: 1.2rem;
    color: var(--text-soft);
    margin: 0;
  }

  /* Anchor links on headings: # reveals on hover */
  .body :global(h2),
  .body :global(h3) {
    margin-top: 2.5rem;
    position: relative;
  }

  .body :global(.heading-anchor) {
    position: absolute;
    left: -1.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
    text-decoration: none;
    opacity: 0;
    transition: opacity 140ms ease;
    font-weight: normal;
    font-size: 0.7em;
    padding: 0 0.2rem;
  }

  .body :global(h2:hover .heading-anchor),
  .body :global(h3:hover .heading-anchor),
  .body :global(.heading-anchor:focus) {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .body :global(.heading-anchor) {
      left: -1.1rem;
    }
  }

  .body :global(pre) {
    background: var(--accent-subtle);
    padding: 1rem 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.5;
    border: 1px solid var(--rule);
  }

  .body :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--text-soft);
    font-style: italic;
    margin: 1.5rem 0;
  }

  .body :global(p) {
    line-height: 1.7;
  }

  .body :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid
      color-mix(in oklch, var(--accent) 35%, transparent);
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .body :global(a:hover) {
    color: var(--accent-hover);
    border-bottom-color: currentColor;
  }

  footer {
    margin-top: var(--section-gap);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  footer a {
    color: var(--accent);
    text-decoration: none;
  }

  footer a:hover {
    color: var(--accent-hover);
  }
</style>
