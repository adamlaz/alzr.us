---
import { ClientRouter } from 'astro:transitions';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title = 'Adam Lazarus',
  description = "Adam Lazarus. Fifteen years of shipping consumer products, founder-side and operator-side. St. Petersburg, FL. Long-form posts on AI-augmented engineering and what works on small teams.",
  ogImage = '/og.png',
  ogType = 'website',
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Preload the latin font subsets the first paint needs:
         Inter (body) + Fraunces (display/wordmark, likely the LCP element).
         Discovered before CSS parse so text doesn't wait on the swap. -->
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={frauncesLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Cross-document view transitions opt-in -->
    <meta name="view-transition" content="same-origin" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="alzr.us" />
    {publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="alzr.us writing"
      href="/rss.xml"
    />

    <!-- Pre-paint theme to avoid FOUC. System then localStorage then data-theme. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- Speculation Rules: prerender internal links on hover (Chromium). -->
    <script is:inline type="speculationrules">
      {
        "prerender": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "selector_matches": "[rel~=external], [data-no-prerender]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- DevTools signature: a small hello to anyone who opens the console. -->
    <script is:inline>
      console.log(
        '%c built deliberately %c\n  github.com/adamlaz/alzr.us\n  ~ adam, from a vault in st. pete',
        'background: oklch(0.42 0.18 265); color: oklch(0.97 0.005 90); padding: 4px 8px; border-radius: 3px; font-family: monospace; font-weight: 500;',
        'color: inherit; font-family: monospace; line-height: 1.6;',
      );
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />

    <script>
      import { init as initKineticType } from '../scripts/kinetic-type';

      // Re-apply theme + reattach toggle after view transitions.
      const applyTheme = () => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      };

      const wireToggle = () => {
        const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
        if (!btn || btn.dataset.wired === '1') return;
        btn.dataset.wired = '1';
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          localStorage.setItem('theme', next);
          document.documentElement.dataset.theme = next;
        });
      };

      applyTheme();
      wireToggle();
      initKineticType();
      document.addEventListener('astro:after-swap', () => {
        applyTheme();
        wireToggle();
        initKineticType();
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0.5rem;
        background: var(--accent);
        color: var(--bg);
        padding: var(--space-2xs) var(--space-xs);
        text-decoration: none;
        border-radius: 4px;
        z-index: 100;
      }
      .skip-link:focus {
        left: 0.5rem;
      }
      .site-main {
        max-width: var(--measure-wide);
        margin: 0 auto;
        padding: var(--page-pad-top) var(--page-pad-x) var(--page-pad-bottom);
      }
    </style>
  </body>
</html>
