---
/**
 * <GivingBriefKitDiagram> -- the kit's run path and the path around it.
 * Top lane: the six steps the orchestrating command runs, in order. Middle
 * lane: the shortcut a research subagent with a shell could take. Bottom
 * lane: the subagent's tool grant after the fix. Structure only: nothing
 * about any candidate. The shortcut is marked by a dashed outline, a label
 * and a struck-through word, never by hue alone.
 */
const intended = [
  'Look up the candidate',
  'Pull the resume',
  'Sweep the public record',
  'Dispatch the researcher',
  'Check citations',
  'Publish',
];
const tools = ['Web search', 'Web fetch', 'Read', 'Glob', 'Grep'];
---

<figure class="kit">
  <div class="lane">
    <p class="lane-title eyebrow">The path I designed: the orchestrator runs every step</p>
    <ol class="steps">
      {intended.map((step) => <li class:list={{ gate: step === 'Check citations' }}>{step}</li>)}
    </ol>
  </div>
  <div class="lane lane--bypass">
    <p class="lane-title eyebrow">The path I left open: a researcher with a shell</p>
    <ol class="steps">
      <li>Research</li>
      <li class="skipped"><s>Check citations</s></li>
      <li class="open">Publish, with the pre-approved script</li>
    </ol>
    <p class="lane-note">Taken three times in one batch run.</p>
  </div>
  <div class="lane">
    <p class="lane-title eyebrow">After the fix: what the researcher can use</p>
    <ul class="tools">
      {tools.map((tool) => <li>{tool}</li>)}
      <li class="removed"><s>Shell</s> <span>removed</span></li>
    </ul>
  </div>
  <figcaption>
    The publish script was pre-approved so the orchestrator could run it without a prompt. The same approval applied
    to any agent holding a shell.
  </figcaption>
</figure>

<style>
  .kit {
    margin: var(--space-xl) 0;
  }

  .lane {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--rule);
  }

  .lane:last-of-type {
    border-bottom: 1px solid var(--rule);
  }

  /* The bypass: the one cobalt rule in the figure. */
  .lane--bypass {
    border-top: 2px solid var(--accent);
  }

  .lane-title {
    margin: 0 0 var(--space-2xs);
  }

  .lane--bypass .lane-title {
    color: var(--accent);
  }

  .lane-note {
    margin: var(--space-2xs) 0 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  ol,
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.3;
  }

  li::before {
    content: none;
  }

  /* The gate the shortcut goes around: heavier outline in ink. */
  li.gate {
    border: 1.5px solid var(--text);
  }

  li.skipped,
  li.removed {
    border-style: dashed;
    color: var(--text-muted);
    font-weight: 400;
  }

  li.open {
    border: 1.5px dashed var(--accent);
  }

  li.removed span {
    font-size: 0.8rem;
  }

  figcaption {
    margin-top: var(--space-sm);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
