---
/**
 * Depth slider controls for depth posts.
 *
 *   variant="header"  the full control under the post description
 *   variant="sticky"  a compact bottom pill that appears once the header
 *                     control scrolls away
 *
 * Both are native range inputs (1-5, step 1), so arrow keys, Home/End and
 * touch dragging come for free. Rendered `hidden`: no-JS readers never see a
 * control that can't work, and get the server-rendered level 3.
 */
import { DEPTH_DEFAULT, DEPTH_LABELS } from '../../lib/depth';

interface Props {
  variant: 'header' | 'sticky';
  minutes: number[];
}

const { variant, minutes } = Astro.props;
const level = DEPTH_DEFAULT;
const label = DEPTH_LABELS[level];
const min = minutes[level - 1];
const valuetext = `${label}, ${min} min read`;
const ticks = [0, 1, 2, 3, 4];
const ariaLabel = 'Reading depth, from business to technical';
---

{
  variant === 'header' ? (
    <div class="depth-control depth-control--header" data-depth-control hidden>
      <span class="end eyebrow" data-depth-set="1" aria-hidden="true">
        Business
      </span>
      <div class="track">
        <span class="ticks" aria-hidden="true">
          {ticks.map((i) => (
            <span class="tick" style={`--i: ${i}`} />
          ))}
        </span>
        <input
          class="range"
          type="range"
          min="1"
          max="5"
          step="1"
          value={level}
          aria-label={ariaLabel}
          aria-valuetext={valuetext}
          data-depth-input
        />
      </div>
      <span class="end eyebrow" data-depth-set="5" aria-hidden="true">
        Technical
      </span>
      <span class="now eyebrow" aria-hidden="true">
        <span data-depth-label>{label}</span> · <span data-depth-min>{min} min</span>
      </span>
      <p class="visually-hidden" aria-live="polite" data-depth-live />
    </div>
  ) : (
    <div class="depth-control depth-control--sticky" data-depth-pill data-shown="false" hidden>
      <div class="track">
        <span class="ticks" aria-hidden="true">
          {ticks.map((i) => (
            <span class="tick" style={`--i: ${i}`} />
          ))}
        </span>
        <input
          class="range"
          type="range"
          min="1"
          max="5"
          step="1"
          value={level}
          aria-label={ariaLabel}
          aria-valuetext={valuetext}
          data-depth-input
        />
      </div>
      <span class="readout eyebrow" aria-hidden="true">
        <span data-depth-label>{label}</span><span class="readout-min"> · <span data-depth-min>{min} min</span></span>
      </span>
    </div>
  )
}

<script>
  import '../../scripts/depth-slider';
</script>

<style>
  .depth-control {
    /* Thumb diameter, and the color it "cuts" out of the rule beneath it. */
    --thumb: 0.875rem;
    --cut: var(--bg);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* `hidden` must beat the flex display above until the script unhides it. */
  .depth-control[hidden] {
    display: none;
  }

  /* ── Header control: a quiet instrument under the standfirst ── */
  .depth-control--header {
    max-width: 26rem;
    margin-top: var(--space-md);
    flex-wrap: wrap;
  }

  .depth-control--header .track {
    flex: 1 1 8rem;
  }

  /* What the slider is set to, on its own line under the track. */
  .now {
    flex: 0 0 100%;
    color: var(--text-soft);
  }

  .end {
    flex: none;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition: color 140ms ease;
  }

  @media (hover: hover) {
    .end:hover {
      color: var(--text-soft);
    }
  }

  /* ── Track: hairline rule + five ticks, the native input on top ── */
  .track {
    position: relative;
    flex: 1;
    min-width: 0;
    height: var(--tap);
  }

  .track::before {
    content: '';
    position: absolute;
    left: calc(var(--thumb) / 2);
    right: calc(var(--thumb) / 2);
    top: calc(50% - 0.5px);
    height: 1px;
    background: var(--rule);
  }

  .ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Ticks sit where the thumb's center lands at each step: the thumb travels
     from half its width to the far edge minus half its width. Ends stand
     taller, like a ruler. */
  .tick {
    position: absolute;
    top: 50%;
    left: calc(var(--thumb) / 2 + (100% - var(--thumb)) * var(--i) / 4);
    width: 1px;
    height: 0.4375rem;
    translate: -50% -50%;
    background: var(--text-muted);
  }

  .tick:first-child,
  .tick:last-child {
    height: 0.6875rem;
  }

  .range {
    -webkit-appearance: none;
    appearance: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  /* The ring moves to the thumb itself (below), where the eye already is. */
  .range:focus-visible {
    outline: none;
  }

  .range::-webkit-slider-runnable-track {
    height: var(--thumb);
    background: transparent;
    border: 0;
  }

  .range::-moz-range-track {
    height: var(--thumb);
    background: transparent;
    border: 0;
  }

  .range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: var(--thumb);
    height: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--cut);
    transition:
      transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 160ms ease;
  }

  .range::-moz-range-thumb {
    width: var(--thumb);
    height: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--cut);
    transition:
      transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 160ms ease;
  }

  .range:focus-visible::-webkit-slider-thumb {
    box-shadow:
      0 0 0 3px var(--cut),
      0 0 0 5px var(--ring);
  }

  .range:focus-visible::-moz-range-thumb {
    box-shadow:
      0 0 0 3px var(--cut),
      0 0 0 5px var(--ring);
  }

  @media (hover: hover) {
    .range:hover::-webkit-slider-thumb {
      transform: scale(1.15);
    }

    .range:hover::-moz-range-thumb {
      transform: scale(1.15);
    }
  }

  .range:active::-webkit-slider-thumb {
    transform: scale(1.25);
  }

  .range:active::-moz-range-thumb {
    transform: scale(1.25);
  }

  /* ── Sticky pill: bottom-center, small, out of the way ── */
  .depth-control--sticky {
    --cut: var(--surface);
    position: fixed;
    left: 50%;
    bottom: calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-depth);
    height: var(--tap);
    padding: 0 var(--space-sm) 0 var(--space-xs);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 999px;
    translate: -50% calc(100% + var(--space-lg));
    opacity: 0;
    visibility: hidden;
    transition:
      translate 280ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms ease,
      visibility 0s linear 280ms;
  }

  .depth-control--sticky[data-shown='true'] {
    translate: -50% 0;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .depth-control--sticky .track {
    flex: none;
    width: 6.5rem;
  }

  /* Fixed width so the pill (and the track under a dragging finger) never
     shifts as the label changes. Sized to the longest label; shorter ones sit
     centered in the slot so the pill stays balanced. */
  .readout {
    font-size: 0.7rem;
    color: var(--text-soft);
    white-space: nowrap;
    text-align: center;
    min-width: 20.5ch;
  }

  .readout-min {
    display: none;
  }

  @media (min-width: 40rem) {
    .readout {
      min-width: 30ch;
    }

    .readout-min {
      display: inline;
    }
  }
</style>
