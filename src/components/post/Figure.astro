---
interface Props {
  src?: string;
  alt?: string;
  decorative?: boolean;
  caption?: string;
  width?: number;
  height?: number;
  zoomable?: boolean;
}

const { src, alt, decorative = false, caption, width, height, zoomable = true } = Astro.props;

// Fail the build on a missing alt, the way the content schema fails on missing
// title/description. A purely decorative image must opt in explicitly.
if (src && !decorative && (alt === undefined || alt.trim() === '')) {
  throw new Error(
    `Figure with src="${src}" needs alt text. Pass alt="..." for an informative image, or decorative for a purely decorative one.`,
  );
}

const canZoom = Boolean(src && !decorative && zoomable);
---

<figure class="post-figure" data-figure-zoom={canZoom ? 'true' : undefined}>
  {
    src ? (
      canZoom ? (
        <>
          <button
            type="button"
            class="figure-zoom-trigger"
            aria-label={`Expand image: ${alt}`}
            data-zoom-open
          >
            <img
              src={src}
              alt={alt}
              width={width}
              height={height}
              loading="lazy"
              decoding="async"
            />
            <span class="figure-zoom-badge" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="10 2 14 2 14 6" />
                <polyline points="6 14 2 14 2 10" />
                <line x1="14" y1="2" x2="9.5" y2="6.5" />
                <line x1="2" y1="14" x2="6.5" y2="9.5" />
              </svg>
              <span>Zoom</span>
            </span>
          </button>
          <dialog class="figure-lightbox" closedby="any" aria-label={alt}>
            <div class="figure-lightbox-inner" data-zoom-surface>
              <div class="figure-lightbox-bar">
                <p class="figure-lightbox-caption">{caption || alt}</p>
                <button
                  type="button"
                  class="figure-lightbox-close"
                  aria-label="Close expanded image"
                  data-zoom-close
                >
                  <span>Close</span>
                  <kbd>Esc</kbd>
                </button>
              </div>
              <div class="figure-lightbox-stage">
                <img
                  class="figure-lightbox-img"
                  src={src}
                  alt={alt}
                  width={width}
                  height={height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </dialog>
        </>
      ) : (
        <img
          src={src}
          alt={decorative ? '' : alt}
          width={width}
          height={height}
          loading="lazy"
          decoding="async"
        />
      )
    ) : (
      <slot />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  function initFigureZoom() {
    const figures = document.querySelectorAll<HTMLElement>('figure[data-figure-zoom="true"]');
    for (const fig of figures) {
      if (fig.dataset.zoomBound === 'true') continue;
      fig.dataset.zoomBound = 'true';

      const openBtn = fig.querySelector<HTMLButtonElement>('[data-zoom-open]');
      const closeBtn = fig.querySelector<HTMLButtonElement>('[data-zoom-close]');
      const dialog = fig.querySelector<HTMLDialogElement>('dialog.figure-lightbox');

      if (!openBtn || !dialog) continue;

      openBtn.addEventListener('click', () => {
        dialog.showModal();
      });

      closeBtn?.addEventListener('click', () => {
        dialog.close();
      });

      // Fallback light-dismiss for browsers without native closedby="any" support,
      // and allow clicking the empty stage padding around the image to dismiss.
      dialog.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;
        if (target === dialog || target.classList.contains('figure-lightbox-stage')) {
          dialog.close();
        }
      });
    }
  }

  initFigureZoom();
  document.addEventListener('astro:page-load', initFigureZoom);
</script>

<style>
  .post-figure {
    margin: 2.5rem 0;
  }

  .post-figure img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .figure-zoom-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    cursor: zoom-in;
    overflow: hidden;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .figure-zoom-trigger:hover {
    border-color: var(--text-muted);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }

  .figure-zoom-trigger:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .figure-zoom-trigger img {
    border-radius: 0;
    width: 100%;
  }

  .figure-zoom-badge {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    background: rgba(18, 17, 16, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #f4f1ea;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    line-height: 1;
    pointer-events: none;
    opacity: 0.82;
    backdrop-filter: blur(6px);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .figure-zoom-trigger:hover .figure-zoom-badge,
  .figure-zoom-trigger:focus-visible .figure-zoom-badge {
    opacity: 1;
    transform: translateY(-1px);
  }

  .figure-lightbox {
    width: min(95vw, 1600px);
    max-width: 95vw;
    max-height: 92dvh;
    margin: auto;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    background: #141312;
    color: #f4f1ea;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55);
  }

  .figure-lightbox:modal {
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
  }

  .figure-lightbox::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: rgba(12, 11, 10, 0.84);
    backdrop-filter: blur(6px);
  }

  .figure-lightbox-inner {
    display: flex;
    flex-direction: column;
    max-height: 92dvh;
    overflow: hidden;
  }

  .figure-lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
  }

  .figure-lightbox-caption {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: rgba(244, 241, 234, 0.85);
    line-height: 1.35;
    max-width: none;
  }

  .figure-lightbox-close {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.1rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    color: #f4f1ea;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 140ms ease, border-color 140ms ease;
  }

  .figure-lightbox-close:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.32);
  }

  .figure-lightbox-close kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.72;
  }

  .figure-lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    overflow: auto;
    overscroll-behavior: contain;
    cursor: zoom-out;
  }

  .figure-lightbox-img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: calc(92dvh - 4.5rem);
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    cursor: default;
  }

  figcaption {
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 16, 'SOFT' 60, 'WONK' 0;
    font-style: italic;
    font-size: 0.92rem;
    color: var(--text-soft);
    text-wrap: balance;
    text-align: center;
  }
</style>

