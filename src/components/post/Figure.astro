---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
---

<figure class="post-figure">
  {src ? <img src={src} alt={alt} loading="lazy" /> : <slot />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-figure {
    margin: 2.5rem 0;
  }

  .post-figure img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }

  figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 16, 'SOFT' 60, 'WONK' 0;
    font-style: italic;
    font-size: 0.92rem;
    color: var(--text-soft);
    text-wrap: balance;
    text-align: center;
  }
</style>
