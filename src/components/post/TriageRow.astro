---
/**
 * <TriageRow> -- one triage row, redrawn in HTML with made-up data. Every value
 * here is a composite from fields no applicant used; nothing is copied from a
 * real row. The layout mirrors what a real row carries: the pile, the flag
 * strip, the vote, a note that names what to probe, and a first question.
 */
import FlagIcon from './FlagIcon.astro';
---

<figure class="triage-row">
  <div class="card">
    <p class="stamp eyebrow">Composite · not a real applicant</p>

    <div class="head">
      <p class="who">Product manager</p>
      <p class="pile"><span class="visually-hidden">Pile: </span>Research</p>
    </div>

    <ul class="flags" aria-label="Flags">
      <li><FlagIcon kind="good" /> Link is live</li>
      <li><FlagIcon kind="good" /> The write-up is theirs</li>
      <li class="quiet">uncalibrated</li>
    </ul>

    <dl class="facts">
      <div>
        <dt>Craft</dt>
        <dd>Strong</dd>
      </div>
      <div>
        <dt>AI story</dt>
        <dd>Specific</dd>
      </div>
      <div>
        <dt>Must-haves</dt>
        <dd>Two still unproven</dd>
      </div>
      <div>
        <dt>Three reads</dt>
        <dd>All agree</dd>
      </div>
    </dl>

    <div class="note">
      <p class="label eyebrow">Note</p>
      <p>
        An AI-written query double-counted refunds. Caught it when the totals didn't match the finance report. Ask how
        they'd size a feature.
      </p>
    </div>

    <div class="note ask">
      <p class="label eyebrow">First question for the call</p>
      <p>Show me that query, and what you changed after the totals didn't match.</p>
    </div>
  </div>
  <figcaption>
    A made-up row in the real row's layout. No applicant wrote this.
  </figcaption>
</figure>

<style>
  .triage-row {
    margin: var(--space-xl) 0;
  }

  .card {
    padding: var(--space-md);
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 1px 0 var(--rule);
  }

  .card p {
    margin: 0;
    line-height: 1.5;
  }

  .stamp {
    color: var(--accent);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-2xs);
  }

  .who {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 28, 'SOFT' 40, 'WONK' 0;
    font-size: 1.3rem;
    font-weight: 500;
  }

  .pile {
    flex: none;
    padding: 0.1rem 0.65rem;
    border: 1.5px solid var(--accent);
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent);
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  .flags li {
    margin: 0;
  }

  .flags .quiet {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
    align-self: center;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
    margin: var(--space-md) 0 0;
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .facts dd {
    margin: var(--space-3xs) 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .note {
    margin-top: var(--space-sm);
  }

  .note .label {
    margin-bottom: var(--space-3xs);
  }

  .note p:not(.label) {
    font-size: 0.97rem;
    color: var(--text-soft);
  }

  .ask {
    padding-left: var(--space-sm);
    border-left: 2px solid var(--accent);
  }

  .ask p:not(.label) {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 20, 'SOFT' 50, 'WONK' 0;
    font-size: 1.08rem;
    color: var(--text);
  }

  figcaption {
    margin-top: var(--space-sm);
    max-width: 58ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  @media (max-width: 40rem) {
    .card {
      padding: var(--space-sm);
    }

    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
