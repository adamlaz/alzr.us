---
interface Props {
  variant?: 'note' | 'aside' | 'warn';
  title?: string;
}

const { variant = 'note', title } = Astro.props;
---

<aside class={`callout callout--${variant}`}>
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--accent);
    background: color-mix(in oklch, var(--accent) 4%, var(--bg));
    border-radius: 0 4px 4px 0;
  }

  .callout--aside {
    border-left-color: var(--text-muted);
    background: color-mix(in oklch, var(--text-muted) 4%, var(--bg));
  }

  .callout--warn {
    border-left-color: var(--color-status-amber);
    background: color-mix(in oklch, var(--color-status-amber) 6%, var(--bg));
  }

  .callout-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .callout--note .callout-title {
    color: var(--accent);
  }

  .callout--warn .callout-title {
    color: var(--color-status-amber);
  }

  .callout-body :global(p) {
    margin: 0;
  }

  .callout-body :global(p + p) {
    margin-top: 0.75rem;
  }
</style>
