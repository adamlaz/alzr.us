---
/**
 * <TriageLanesDiagram> -- two short lanes and the line between them. The top
 * lane is what the machines do to every application; the bottom lane is the
 * sequence a person runs. Structure only: no counts, nothing about any one
 * applicant.
 */
const machines = ['Scripted checks', 'Three model reads', 'A vote', 'A note, flags and a pile'];
const person = ['My read', '30-minute screen', 'Work sample', 'Deep dive with a teammate', 'Final round'];
---

<figure class="lanes">
  <div class="lane">
    <p class="lane-title eyebrow">Machines check</p>
    <ol class="steps">
      {machines.map((step) => <li>{step}</li>)}
    </ol>
  </div>
  <div class="lane lane--person">
    <p class="lane-title eyebrow">A person decides</p>
    <ol class="steps">
      {person.map((step) => <li>{step}</li>)}
    </ol>
  </div>
  <figcaption>The top lane runs overnight. The bottom lane hasn't started.</figcaption>
</figure>

<style>
  .lanes {
    margin: var(--space-xl) 0;
  }

  .lane {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--rule);
  }

  /* The hand-off: the one cobalt rule in the figure. */
  .lane--person {
    border-top: 2px solid var(--accent);
    border-bottom: 1px solid var(--rule);
  }

  .lane-title {
    margin: 0 0 var(--space-2xs);
  }

  .lane--person .lane-title {
    color: var(--accent);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
  }

  li::before {
    content: none;
  }

  li + li::before {
    content: '';
    width: 0.9rem;
    height: 0;
    margin: 0 var(--space-2xs);
    border-top: 1px solid var(--text-muted);
  }

  .lane--person li {
    padding: 0.2rem 0.7rem;
    border: 1.5px solid var(--accent);
    border-radius: 999px;
  }

  .lane--person li + li {
    margin-left: 0;
  }

  .lane--person ol {
    gap: var(--space-2xs);
  }

  .lane--person li + li::before {
    content: none;
  }

  figcaption {
    margin-top: var(--space-sm);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
