---
interface Props {
  id: string | number;
}

const { id } = Astro.props;
const idStr = String(id);
---

<sup class="fn-ref" id={`fnref-${idStr}`}>
  <a href={`#fn-${idStr}`} aria-label={`Footnote ${idStr}`}>{idStr}</a>
</sup>

<style>
  .fn-ref {
    font-family: var(--font-mono);
    font-size: 0.7em;
    line-height: 0;
    margin-left: 0.1em;
  }

  .fn-ref a {
    color: var(--accent);
    text-decoration: none;
    /* Inline superscript refs are exempt from WCAG 2.5.8 (targets in a text
       sentence). A full 44px strip here would overlap neighboring lines and
       *hurt* aim, so we widen the padded area instead; line-height: 0 on .fn-ref
       keeps the bigger padding from disturbing the surrounding line box. */
    padding: 0.4em 0.5em;
    border-radius: 3px;
    transition:
      background 140ms ease,
      color 140ms ease;
  }

  @media (hover: hover) {
    .fn-ref a:hover {
      background: color-mix(in oklch, var(--accent) 12%, transparent);
    }
  }

  .fn-ref a:active {
    background: color-mix(in oklch, var(--accent) 18%, transparent);
    color: var(--accent-hover);
  }
</style>
