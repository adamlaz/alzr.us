---
/**
 * <Chart> -- a pre-rendered data chart (light + dark SVG pair from a .gen.mjs
 * built on src/assets/diagrams/_chart.mjs). Unlike <Diagram>, a chart sits
 * straight on the page between two hairlines: the title states the finding,
 * the SVG carries the marks, the caption carries the source and caveats.
 * The default slot is the required text alternative for screen readers.
 */
interface Props {
  lightSvg: string;
  darkSvg: string;
  title: string;
  caption?: string;
  maxWidth?: number;
}

const { lightSvg, darkSvg, title, caption, maxWidth = 520 } = Astro.props;
---

<figure class="post-chart" style={`--chart-max-width: ${maxWidth}px`}>
  <div class="chart-title">{title}</div>
  <div class="chart light" set:html={lightSvg} aria-hidden="true"></div>
  <div class="chart dark" set:html={darkSvg} aria-hidden="true"></div>
  <p class="visually-hidden"><slot /></p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-chart {
    margin: var(--space-xl) 0;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .chart-title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 28, 'SOFT' 40, 'WONK' 0;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }

  .chart :global(svg) {
    display: block;
    width: 100%;
    max-width: var(--chart-max-width, 520px);
    height: auto;
    overflow: visible;
  }

  .dark {
    display: none;
  }
  :global([data-theme='dark']) .light {
    display: none;
  }
  :global([data-theme='dark']) .dark {
    display: block;
  }

  figcaption {
    margin-top: var(--space-md);
    max-width: 58ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }
</style>
