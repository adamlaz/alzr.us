---
interface Footnote {
  id: string;
  body: string;
}

interface Props {
  notes: Footnote[];
}

const { notes } = Astro.props;
---

{
  notes.length > 0 && (
    <section class="footnotes" aria-labelledby="footnotes-heading">
      <h2 id="footnotes-heading">Notes</h2>
      <ol>
        {notes.map((note) => (
          <li id={`fn-${note.id}`}>
            <span class="fn-body" set:html={note.body} />{' '}
            <a
              href={`#fnref-${note.id}`}
              class="fn-back"
              aria-label={`Back to reference ${note.id}`}
            >
              ↩
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .footnotes {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }

  .footnotes h2 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'SOFT' 50, 'WONK' 0;
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 1.25rem;
  }

  .footnotes ol {
    margin: 0;
    padding-left: var(--space-md);
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  .footnotes li {
    margin-bottom: var(--space-xs);
    line-height: 1.55;
  }

  .footnotes li:last-child {
    margin-bottom: 0;
  }

  /* Accent (not muted) for AA contrast on paper, matching the other footnote
     links. The visible box stays 24px tall so it doesn't balloon the notes line
     box; the ::before strip lifts the full tap target to 44px (WCAG 2.5.5). */
  .fn-back {
    display: inline-block;
    position: relative;
    min-width: var(--tap);
    min-height: 24px;
    line-height: 24px;
    text-align: center;
    color: var(--accent);
    text-decoration: none;
    margin-left: var(--space-3xs);
    transition: color 140ms ease;
  }

  .fn-back::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: var(--tap);
    transform: translateY(-50%);
  }

  @media (hover: hover) {
    .fn-back:hover {
      color: var(--accent-hover);
    }
  }

  .fn-back:active {
    color: var(--accent-hover);
  }

  .fn-body :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid
      color-mix(in oklch, var(--accent) 35%, transparent);
  }

  @media (hover: hover) {
    .fn-body :global(a:hover) {
      border-bottom-color: currentColor;
    }
  }
</style>
