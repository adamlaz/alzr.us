---
/**
 * <FlagIcon> -- the four triage flags as one-color line icons, drawn in the
 * site's ink and cobalt. Shape carries the meaning, never hue. Decorative by
 * default: the text beside the icon names the flag.
 */
interface Props {
  kind: 'good' | 'problem' | 'look' | 'info';
}

const { kind } = Astro.props;
---

<svg class:list={['flag-icon', `flag-icon--${kind}`]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
  {
    kind === 'good' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" fill="currentColor" />
        <path d="M7.5 12.5l3.2 3.2 5.8-7" fill="none" stroke="var(--bg)" stroke-width="2.4" />
      </>
    )
  }
  {
    kind === 'problem' && (
      <>
        <path d="M12 3.5L21.5 20h-19z" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M12 10v4.5M12 17.2v.3" fill="none" stroke="currentColor" stroke-width="2.2" />
      </>
    )
  }
  {
    kind === 'look' && (
      <>
        <circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M15 15l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.4" />
      </>
    )
  }
  {
    kind === 'info' && (
      <>
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M12 11v6M12 7.3v.3" fill="none" stroke="currentColor" stroke-width="2.2" />
      </>
    )
  }
</svg>

<style>
  .flag-icon {
    display: inline-block;
    flex: none;
    width: 1.25em;
    height: 1.25em;
    vertical-align: -0.25em;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--text);
  }

  .flag-icon--good {
    color: var(--accent);
  }

  .flag-icon--info {
    color: var(--text-muted);
  }
</style>
