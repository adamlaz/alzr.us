---
import Wordmark from './Wordmark.astro';

const links = [
  { href: '/writing', label: 'Posts' },
  { href: '/projects', label: 'Work' },
  { href: '/now', label: 'Now' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav" data-sticky-nav>
  <Wordmark href="/" />
  <nav aria-label="Primary">
    <ul>
      {
        links.map(({ href, label }) => {
          const active = path === href || path.startsWith(`${href}/`);
          // Shared-element morph: nav labels and the route pages' <h1>s share these
          // route-* names. REVERSE ONLY -- on navigation the OUTGOING title recedes
          // into the destination's matching nav label (the forward grow flew large
          // letters at the viewer, too in-your-face). BaseLayout's
          // astro:before-preparation handler strips the route names off this page's
          // nav links pre-snapshot so the forward direction can't fire. The name is
          // still suppressed on the ACTIVE link so the current page never holds the
          // same view-transition-name twice (nav link + its own <h1>), which would
          // disable the transition.
          const viewName = `route-${href.replace(/\//g, '')}`;
          return (
            <li>
              {active ? (
                <a href={href} aria-current="page">
                  {label}
                </a>
              ) : (
                <a href={href} transition:name={viewName}>
                  {label}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
  <button type="button" data-theme-toggle aria-label="Toggle color theme">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
  </button>
</header>

<style>
  .nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-md);
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: var(--page-pad-x) var(--page-pad-x) 0;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  nav a {
    color: var(--text-soft);
    text-decoration: none;
    position: relative;
    display: inline-block;
    /* Visual padding keeps the aria-current underline on the text baseline; the
       full 44px tap target is the invisible ::before strip below, so the touch
       area clears WCAG 2.5.5 without thickening the editorial header. */
    padding: var(--space-2xs) 0 2px;
  }

  /* Tap-target expander: a 44px-tall hit strip centered on the link, link-width
     wide. The 16px flex gap keeps adjacent strips from touching. */
  nav a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: var(--tap);
    transform: translateY(-50%);
  }

  @media (hover: hover) {
    nav a:hover {
      color: var(--accent);
    }
  }

  /* Press feedback -- the touch counterpart to :hover. Color shift is instant
     and reduced-motion-safe (no transform to gate). */
  nav a:active {
    color: var(--accent-hover);
  }

  /* aria-current drives the active-route underline. Server-rendered at build,
     no JS state. */
  nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -1px 0 0 var(--accent);
  }

  button[data-theme-toggle] {
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--text-soft);
    border-radius: 999px;
    width: var(--tap);
    height: var(--tap);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      color 120ms ease,
      border-color 120ms ease,
      background-color 120ms ease,
      transform 120ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The icon rotates on theme flip; ease it instead of hard-snapping
     (reduced-motion is neutralized by the global * transition kill). */
  button[data-theme-toggle] svg {
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    button[data-theme-toggle]:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
  }

  /* Press: tint + a faint push. The background fill is the reduced-motion-safe
     feedback; the scale only rides when motion is allowed. */
  button[data-theme-toggle]:active {
    background: var(--accent-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    button[data-theme-toggle]:active {
      transform: scale(0.92);
    }
  }

  [data-theme='dark'] button[data-theme-toggle] svg {
    /* Moon-ify: a single mask circle to look like a crescent without a second icon. */
    transform: rotate(-20deg);
  }

  /* md (40rem): the nav drops to a two-row grid AND becomes a smart sticky bar
     -- it hides on scroll-down and returns on scroll-up, so the wordmark stays
     one flick away on tall phones. The viewport is narrower than --measure-wide
     here, so the bar fills the width and its --bg backdrop covers cleanly.
     `1fr auto` keeps the wordmark left and pins the toggle right (mirrors the
     desktop `auto 1fr auto`); a hairline reads the edge content slides under.
     Desktop keeps the static, borderless header above. */
  @media (max-width: 40rem) {
    .nav {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      position: sticky;
      top: 0;
      z-index: var(--z-header);
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      padding-bottom: var(--space-xs);
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .nav[data-hidden='true'] {
      transform: translateY(-100%);
    }
    /* Wordmark is inline-grid from a child component; in the 1fr track its
       default justify-self: stretch would balloon the box into a full-width
       invisible home-link target. Pin it to content width at the start. */
    .nav :global(.wordmark) {
      justify-self: start;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    nav ul {
      justify-content: flex-start;
    }
  }

  /* Reduced motion: never translate the bar away (no jarring snap). The script
     also skips wiring under reduced motion; this is the CSS backstop. */
  @media (prefers-reduced-motion: reduce) {
    .nav[data-hidden='true'] {
      transform: none;
    }
  }
</style>
