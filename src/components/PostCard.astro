---
interface Props {
  href: string;
  slug: string;
  title: string;
  date: Date;
  description: string;
}

const { href, slug, title, date, description } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// Scope the whole-card link's accessible name to the title, so screen readers
// don't read the date + full description as the link label on every card.
const headingId = `post-title-${href.split('/').filter(Boolean).pop()}`;
---

<article class="post-card">
  <a href={href} aria-labelledby={headingId}>
    <time class="eyebrow" datetime={date.toISOString()}>{formatted}</time>
    <h2 id={headingId} data-kinetic transition:name={`post-title-${slug}`}>
      {title}
    </h2>
    <p>{description}</p>
  </a>
</article>

<style>
  .post-card {
    padding: var(--list-gap) 0;
    border-bottom: 1px solid var(--rule);
  }

  .post-card a {
    display: block;
    color: inherit;
    text-decoration: none;
    /* Net-zero shift (margin -8px, padding +8px) lets the press tint bleed past
       the text into the gutter, so a tap reads as a lit-up row. */
    margin-inline: calc(-1 * var(--space-2xs));
    padding-inline: var(--space-2xs);
    border-radius: 6px;
    transition: background-color 140ms ease;
  }

  @media (hover: hover) {
    .post-card a:hover h2 {
      color: var(--accent);
    }
  }

  /* Press feedback on touch: the whole card lights. Background-only, so it needs
     no reduced-motion gate. */
  .post-card a:active {
    background: var(--accent-subtle);
  }

  /* Keyboard focus gets the same title cue as hover, not just the bare ring. */
  .post-card a:focus-visible h2 {
    color: var(--accent);
  }

  h2 {
    margin: var(--space-3xs) 0 var(--space-2xs);
    font-size: 1.5rem;
    transition: color 140ms ease;
  }

  p {
    color: var(--text-soft);
    margin: 0;
  }
</style>
