---
const year = new Date().getFullYear();

const links = [
  { href: '/rss.xml', label: 'RSS', external: false },
  { href: 'https://github.com/adamlaz', label: 'GitHub', external: true },
  { href: 'https://www.linkedin.com/in/adamlaz/', label: 'LinkedIn', external: true },
];

// Vercel injects these at build time. Fall back to a local-build label.
const sha = (import.meta.env.VERCEL_GIT_COMMIT_SHA ?? '').slice(0, 7);
const builtAt = new Date();
const builtLabel = builtAt
  .toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
  .toLowerCase();
const buildLine = sha ? `built ${builtLabel} · sha ${sha}` : `local build · ${builtLabel}`;
const buildHref = sha ? `https://github.com/adamlaz/alzr.us/commit/${sha}` : undefined;
---

<footer class="site-footer">
  <hr />
  <div class="row">
    <p>© {year} Adam Lazarus</p>
    <ul>
      {
        links.map(({ href, label, external }) => (
          <li>
            <a
              href={href}
              {...(external ? { rel: 'external me', 'data-no-prerender': true } : {})}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="build">
    <span class="dot" aria-hidden="true"></span>
    {
      buildHref ? (
        <a href={buildHref} rel="external" data-no-prerender>
          {buildLine}
        </a>
      ) : (
        <span>{buildLine}</span>
      )
    }
  </p>
</footer>

<style>
  .site-footer {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: 0 var(--page-pad-x) var(--space-xl);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-md);
  }

  .row a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  .row a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .build {
    margin: var(--space-md) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .build a {
    color: inherit;
    text-decoration: none;
  }

  .build a:hover {
    color: var(--accent);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.5;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: build-pulse 3s ease-in-out infinite;
    }
  }

  @keyframes build-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.65;
    }
  }
</style>
