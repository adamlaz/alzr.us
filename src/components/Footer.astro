---
const year = new Date().getFullYear();

const links = [
  { href: 'https://github.com/adamlaz', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/adamlaz/', label: 'LinkedIn' },
  { href: 'https://bsky.app/profile/adamlaz.bsky.social', label: 'Bluesky' },
];
---

<footer class="site-footer">
  <hr />
  <div class="row">
    <p>© {year} Adam Lazarus</p>
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} rel="external me" data-no-prerender>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    max-width: 68ch;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }

  a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }

  a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
